<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="content-area"
      xmlns="http://javafx.com/javafx/27.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cineController.ControladorCartelera">
    <children>
        <Label styleClass="page-title" text="Cartelera" />

        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="field-label" text="Película" />
                        <ComboBox fx:id="cmbPelicula" maxWidth="1.7976931348623157E308" promptText="Todas las películas" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="field-label" text="Fecha" />
                        <DatePicker fx:id="dpFecha" />
                    </children>
                </VBox>

                <Button fx:id="btnBuscar" onAction="#buscarFunciones"
                        styleClass="btn-secondary" text="Buscar" />
                <Button fx:id="btnLimpiar" onAction="#limpiarFiltros"
                        styleClass="btn-secondary" text="Limpiar" />
            </children>
        </HBox>

        <TableView fx:id="tblFunciones" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPelicula" prefWidth="220.0" text="Película" />
                <TableColumn fx:id="colSala" prefWidth="130.0" text="Sala" />
                <TableColumn fx:id="colHorario" prefWidth="120.0" text="Horario" />
                <TableColumn fx:id="colPrecio" prefWidth="130.0" text="Precio" />
                <TableColumn fx:id="colAccion" prefWidth="140.0" text="Acción" />
            </columns>
        </TableView>

        <Label fx:id="lblSinResultados" managed="false" styleClass="hint-text"
               text="No hay funciones para estos filtros." visible="false" />
    </children>
</VBox>