<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="content-area"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cineController.ControladorInicio">
    <children>
        <VBox spacing="4.0">
            <children>
                <Label styleClass="page-title" text="Sistema de reservas de cine" />
                <Label fx:id="lblSubtituloSucursal" styleClass="hint-text"
                       text="UTN FRA · Gestión de cartelera, salas, funciones y reservas" />
            </children>
        </VBox>

        <GridPane hgap="14.0" vgap="14.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
            </columnConstraints>
            <children>
                <VBox spacing="4.0" styleClass="summary-box" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <children>
                        <Label styleClass="field-label" text="Funciones programadas" />
                        <Label fx:id="lblTotalFunciones" styleClass="page-title" text="0" />
                        <Label styleClass="hint-text" text="Disponibles en cartelera" />
                    </children>
                </VBox>

                <VBox spacing="4.0" styleClass="summary-box" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <children>
                        <Label styleClass="field-label" text="Reservas confirmadas" />
                        <Label fx:id="lblTotalReservas" styleClass="page-title" text="0" />
                        <Label styleClass="hint-text" text="En historial de sucursal" />
                    </children>
                </VBox>

                <VBox spacing="4.0" styleClass="summary-box" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <children>
                        <Label styleClass="field-label" text="Salas habilitadas" />
                        <Label fx:id="lblTotalSalas" styleClass="page-title" text="0" />
                        <Label styleClass="hint-text" text="Con grilla de butacas" />
                    </children>
                </VBox>

                <VBox spacing="4.0" styleClass="summary-box" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <children>
                        <Label styleClass="field-label" text="Películas registradas" />
                        <Label fx:id="lblTotalPeliculas" styleClass="page-title" text="0" />
                        <Label styleClass="hint-text" text="Catálogo persistido" />
                    </children>
                </VBox>
            </children>
        </GridPane>

        <VBox spacing="10.0" styleClass="summary-box">
            <children>
                <Label styleClass="topbar-brand" text="Accesos rápidos" />
                <Label styleClass="hint-text"
                       text="Consultá las funciones vigentes, iniciá una reserva o administrá películas, salas y horarios." />
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnIrCartelera" onAction="#irACartelera"
                                styleClass="btn-primary" text="Ir a cartelera" />
                        <Button fx:id="btnIrReservas" onAction="#irAReservas"
                                styleClass="btn-secondary" text="Consultar reservas" />
                        <Button fx:id="btnIrFunciones" onAction="#irAFunciones"
                                styleClass="btn-secondary" text="Programar función" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label fx:id="lblEstadoPersistencia" styleClass="hint-text"
               text="Estado de datos: listo para cargar desde archivos en datasave/." />
    </children>
</VBox>