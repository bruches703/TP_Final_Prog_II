<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="content-area"
      xmlns="http://javafx.com/javafx/27.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cineController.ControladorSalas">
    <children>
        <Label styleClass="page-title" text="Salas" />

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="10.0" styleClass="summary-box" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="section-title" text="Salas registradas" />

                        <TableView fx:id="tblSalas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colIdSala" prefWidth="95.0" text="ID Sala" />
                                <TableColumn fx:id="colCapacidad" prefWidth="150.0" text="Total butacas" />
                                <TableColumn fx:id="colDisponible" prefWidth="135.0" text="Estado" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button fx:id="btnVolver" onAction="#volver"
                                        styleClass="btn-secondary" text="← Volver" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox prefWidth="320.0" spacing="12.0" styleClass="summary-box">
                    <children>
                        <Label styleClass="section-title" text="Gestión de sala" />

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="field-label" text="Número / ID de sala" />
                                <TextField fx:id="txtIdSala" promptText="Ej: 4" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="field-label" text="Cantidad de filas" />
                                <TextField fx:id="txtFilas" promptText="Ej: 5" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="field-label" text="Asientos por fila" />
                                <TextField fx:id="txtAsientosPorFila" promptText="Ej: 8" />
                            </children>
                        </VBox>

                        <CheckBox fx:id="chkDisponible" selected="true" text="Sala disponible" />

                        <Button fx:id="btnAgregarSala" maxWidth="1.7976931348623157E308"
                                onAction="#agregarSala" styleClass="btn-primary"
                                text="Agregar sala" />

                        <Button fx:id="btnModificarSala" maxWidth="1.7976931348623157E308"
                                onAction="#modificarSala" styleClass="btn-secondary"
                                text="Modificar seleccionada" />
                        

                        <Label fx:id="lblMensaje" styleClass="hint-text" text="" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
