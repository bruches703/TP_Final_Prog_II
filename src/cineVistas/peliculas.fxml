<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="content-area"
      xmlns="http://javafx.com/javafx/27.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cineController.ControladorPeliculas">
    <children>
        <Label styleClass="page-title" text="Películas" />

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="10.0" styleClass="summary-box" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="section-title" text="Películas registradas" />

                        <TableView fx:id="tblPeliculas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTitulo" prefWidth="240.0" text="Título" />
                                <TableColumn fx:id="colDuracion" prefWidth="120.0" text="Duración (min)" />
                                <TableColumn fx:id="colActiva" prefWidth="110.0" text="Activa" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button fx:id="btnVolver" onAction="#volver"
                                        styleClass="btn-secondary" text="← Volver" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox prefWidth="320.0" spacing="12.0" styleClass="summary-box">
                    <children>
                        <Label styleClass="section-title" text="Gestión de película" />

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="field-label" text="Título" />
                                <TextField fx:id="txtTitulo" promptText="Ej: El Eternauta" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="field-label" text="Duración (minutos)" />
                                <TextField fx:id="txtDuracion" promptText="Ej: 120" />
                            </children>
                        </VBox>

                        <CheckBox fx:id="chkActiva" selected="true" text="Activa en cartelera" />

                        <Button fx:id="btnAgregarPelicula" maxWidth="1.7976931348623157E308"
                                onAction="#agregarPelicula" styleClass="btn-primary"
                                text="Agregar película" />

                        <Button fx:id="btnModificarPelicula" maxWidth="1.7976931348623157E308"
                                onAction="#modificarPelicula" styleClass="btn-secondary"
                                text="Modificar seleccionada" />

                        <Label fx:id="lblMensaje" styleClass="hint-text" text="" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>